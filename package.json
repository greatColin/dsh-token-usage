{
  "name": "dsh-token-usage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hourly token usage per session, filterable by session and workspace, read from the local session logs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/greatColin/dsh-token-usage.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "token",
    "usage"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
